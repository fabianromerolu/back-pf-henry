{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "application/mailer/assets/**/*",
        "outDir": "dist/application/mailer/assets"
      },
      {
        "include": "application/mailer/templates/**/*",
        "outDir": "dist/application/mailer/templates"
      }
    ]

  }
}
